# BUILD.jobs — package the gomod fetcher as a JOBS artifact.
#
# gomod is a shell script, but it is not self-sufficient: it drives `go mod
# download`, so it needs a Go toolchain at fetch time. Since jobs-iroh's
# hermetic imports, a fetcher runs in a sandbox that holds ONLY the static
# shell userland plus the fetcher's own runtime closure — nothing from the
# runner host. The toolchain is therefore declared here as a runtime dep, and
# its in-store path is baked into env.sh (the same /jobs/store/<key> path the
# import sandbox mounts the closure at), which `fetch` sources on start.
# Output: { fetch, env.sh }.

def build():
    goarch = {"linux/amd64": "amd64", "linux/arm64": "arm64"}[platform]
    go_sha = {
        "amd64": "1153d3d50e0ac764b447adfe05c2bcf08e889d42a02e0fe0259bd47f6733ad7f",
        "arm64": "ef758ae7c6cf9267c9c0ef080b8965f453d89ab2d25d9eb22de4405925238768",
    }
    toolchain = imp(fetcher = "tarball+https", params = {
        "url": "https://go.dev/dl/go1.26.4.linux-" + goarch + ".tar.gz",
        "sha256": go_sha[goarch],
    })
    script = """
set -eu
mkdir -p "$out"
cp "$SRC/fetch" "$out/fetch"
chmod +x "$out/fetch"
# Bake the toolchain's store path: inside an import sandbox the runtime
# closure is mounted at exactly these /jobs/store/<key> paths.
goroot="$(jq -r .toolchain <<<"$JOBS_DEPS")/go"
[ -x "$goroot/bin/go" ] || { echo "toolchain has no go binary at $goroot/bin/go" >&2; exit 1; }
cat > "$out/env.sh" <<ENV
# generated by BUILD.jobs — sourced by fetch
export GOROOT="$goroot"
export PATH="$goroot/bin:\\$PATH"
ENV
"""
    return struct(
        name = "gomod fetcher",
        inputs = {"toolchain": toolchain},
        env = {},
        script = script,
        runtime_deps = [toolchain],
    )
